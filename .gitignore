# ============================================================
# 敏感信息：绝不提交
# ------------------------------------------------------------
# 真实密钥 / token / 凭据统一放 .env（已忽略），仓库里只保留 .env.example 模板
.env
.env.*
!.env.example
*.key
*.pem
*.p12
secrets*.json
credentials*.json

# ============================================================
# Python 运行产物
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# 测试 / 覆盖率 / 缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ============================================================
# 项目运行数据：会话记录、待办、trace 日志（本地隐私数据）
# ------------------------------------------------------------
data/
logs/
*.log
*.jsonl
*.tmp

# ============================================================
# IDE / 编辑器 / 操作系统
# ------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
