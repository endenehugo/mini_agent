# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，永远不会提交到仓库。

# LLM 服务地址（OpenAI 兼容协议；默认阿里云百炼 DashScope）
LLM_BASE_URL = https://dashscope.aliyuncs.com/compatible-mode/v1

# 你的 API Key（必填，敏感信息，不要写进任何会被提交的文件）
LLM_API_KEY = sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 模型名
LLM_MODEL = qwen3.8-flash

# 可选：透传给 API 的额外参数（JSON 格式，默认空对象）
# LLM_EXTAR_BODY = {"enable_thinking": false}

# 可选：Agent 运行时参数（都有内置默认值）
# MAX_TURNS = 10
# CONTEXT_TOKEN_LIMIT = 6000
# KEEP_RECENT_EVENTS = 2
# MAX_TOOL_RESULT_CHARS = 4000
